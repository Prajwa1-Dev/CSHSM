# =====================================================================
# CSHSM — Counter-Speech Generation for Hate Content in Social Media
# Runtime Environment Configuration Template (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# Live Model Provider Credentials (Required for Live Execution)
# ---------------------------------------------------------------------
# Cloudflare Workers AI (Generators 1 & 2: Gemma 4 26B IT, GLM-4.7-Flash)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Groq Cloud API (Generators 3, 4 & 5: GPT-OSS-20B, Qwen 3.8 27B, GPT-OSS-120B)
GROQ_API_KEY=

# Google AI Studio / Gemini API (Evaluator: Gemini Flash-Lite LLM Judge)
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Pipeline Mode & Execution Controls
# ---------------------------------------------------------------------
# Pipeline orchestrator mode: "m8" for authoritative Milestone 8 pipeline
CSHSM_PIPELINE_MODE=m8

# Live vs. Offline Mock Execution:
# Set CSHSM_M8_LIVE=1 to activate real external generation & evaluation
CSHSM_M8_LIVE=0

# Force completely offline mock execution (conflicts if both LIVE and MOCK are 1)
CSHSM_M8_MOCK=0

# Use real local Multitask XLM-R classifier weights (models/xlmr_best.pt)
CSHSM_M8_USE_REAL_CLASSIFIER=1

# Knowledge Base version and embedding directory
CSHSM_KB_VERSION=v2
CSHSM_KB_EMBEDDINGS_DIR=data/counter_speech_kb/embeddings_v2

# Force mock KB retriever if set to 1 (default 0 uses real 300-record KB V2)
CSHSM_M8_USE_MOCK_KB=0

# ---------------------------------------------------------------------
# Web Server Configuration
# ---------------------------------------------------------------------
ENVIRONMENT=development
PORT=5000
